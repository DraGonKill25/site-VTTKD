{
  "name": "van-thuyne-taekwondo-elite",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node node_modules/astro/bin/astro.mjs dev",
    "build": "npm run check && node node_modules/astro/bin/astro.mjs build",
    "build:poc": "npm run check && node scripts/build-poc.mjs",
    "preview": "node node_modules/astro/bin/astro.mjs preview",
    "preview:poc": "node scripts/preview-poc.mjs",
    "check": "node node_modules/astro/bin/astro.mjs check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:site": "node scripts/check-built-site.mjs",
    "test:site:poc": "node scripts/check-built-site.mjs --poc && node scripts/check-poc-build.mjs",
    "test:e2e": "playwright test",
    "test:visual": "playwright test --project=chromium --grep @visual",
    "test:a11y": "playwright test --project=chromium --grep @a11y",
    "test:poc": "playwright test --config=playwright.poc.config.ts",
    "test:security": "node scripts/phase4-security-check.mjs && playwright test --grep @security",
    "test:lighthouse": "node scripts/run-phase4-lighthouse.mjs",
    "test:phase4": "npm run build && npm run test:site && npm test && npm run test:e2e && npm run test:lighthouse && node scripts/phase4-security-check.mjs"
  },
  "dependencies": {
    "astro": "7.4.13"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.1",
    "@types/node": "22.20.5",
    "lighthouse": "13.6.0",
    "node": "22.23.4",
    "typescript": "6.0.3",
    "vitest": "5.1.1"
  },
  "engines": {
    "node": ">=22.23.4"
  }
}
