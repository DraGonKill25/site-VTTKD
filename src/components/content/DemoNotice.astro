---
import type { Language } from "../../config/site";
import { getUi } from "../../i18n/ui";

interface Props {
  lang: Language;
  compact?: boolean;
}

const { lang, compact = false } = Astro.props;
const t = getUi(lang);
---

<aside class:list={["demo-notice", { "demo-notice-compact": compact }]}>
  <strong>{t.demo}</strong>
  {!compact && <span>{t.demoText}</span>}
</aside>
