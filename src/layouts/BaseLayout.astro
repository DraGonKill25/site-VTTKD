---
import type { Language } from "../config/site";
import { SITE_NAME } from "../config/site";
import SiteFooter from "../components/layout/SiteFooter.astro";
import SiteHeader from "../components/layout/SiteHeader.astro";
import { route } from "../i18n/routes";
import { getUi } from "../i18n/ui";
import "../styles/global.css";

interface Props {
  lang: Language;
  title: string;
  description: string;
  alternatePath?: string;
  canonicalPath?: string;
  image?: string;
}

const {
  lang,
  title,
  description,
  alternatePath,
  canonicalPath = Astro.url.pathname,
  image,
} = Astro.props;
const canonicalOrigin = Astro.site ?? Astro.url.origin;
const canonical = new URL(canonicalPath, canonicalOrigin);
const otherLanguage = lang === "fr" ? "en" : "fr";
const alternate = new URL(
  alternatePath ?? route(otherLanguage, "home"),
  canonicalOrigin,
);
const allowIndexing = import.meta.env.PUBLIC_ALLOW_INDEXING === "true";
const isPoc = import.meta.env.PUBLIC_POC_MODE === "true";
const fullTitle = title === SITE_NAME ? title : `${title} | ${SITE_NAME}`;
const t = getUi(lang);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta
      name="robots"
      content={allowIndexing ? "index,follow" : "noindex,nofollow"}
    />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={lang} href={canonical} />
    <link rel="alternate" hreflang={otherLanguage} href={alternate} />
    <link rel="alternate" hreflang="x-default" href={new URL(route("fr", "home"), canonicalOrigin)} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={lang === "fr" ? "fr_FR" : "en_GB"} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {image && <meta property="og:image" content={new URL(image, canonicalOrigin)} />}
    <title>{fullTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">
      {lang === "fr" ? "Aller au contenu" : "Skip to content"}
    </a>
    {
      isPoc && (
        <aside class="poc-banner" role="note" aria-label={t.pocTitle}>
          <div class="site-container">
            <strong>{t.pocTitle}</strong>
            <span>{t.pocText}</span>
          </div>
        </aside>
      )
    }
    <SiteHeader
      lang={lang}
      pathname={Astro.url.pathname}
      alternatePath={alternatePath}
    />
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <SiteFooter lang={lang} />
  </body>
</html>
