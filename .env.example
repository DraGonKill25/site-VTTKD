# Aucun secret n'est requis pour le site statique.
# Les variables d'un futur formulaire ou CMS seront ajoutées uniquement après
# validation du fournisseur et resteront dans l'environnement de déploiement.

# Le build POC les définit automatiquement. Ne jamais activer l'indexation
# pour la démonstration GitHub Pages.
# PUBLIC_POC_MODE=true
# PUBLIC_ALLOW_INDEXING=false
# POC_BUILD=true
# POC_SITE_URL=https://owner.github.io
# POC_BASE_PATH=/repository/
